FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key

# Optional AI Provider (leave blank to use rule-based fallback)
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite:///instance/warehouse.db

# SMTP Real Email OTP Dispatcher (Gmail / Mailtrap / Custom SMTP)
# For Gmail: Use smtp.gmail.com with 587 port and your 16-character Gmail App Password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER_EMAIL=no-reply@waremind.ai
SMTP_USE_TLS=1
